# Copy to hub/.env (never commit it) and fill in. `npm start` in hub/ reads it.

# The address people open. Without a domain, use your server's IP as a free sslip.io name.
HUB_URL=https://140-245-26-67.sslip.io

# From your GitHub OAuth App (callback URL: HUB_URL + /auth/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub logins that run the hub: always let in, and the only ones who can approve or block people.
HUB_ADMINS=

# Optional: members of this GitHub organisation get in without waiting for approval.
HUB_AUTO_APPROVE_ORG=

# Behind Caddy or nginx the hub only needs to listen locally.
HOST=127.0.0.1
PORT=4800
